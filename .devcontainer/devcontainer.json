// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-outside-of-docker
{
  "name": "Astroshop202609Demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "upgradePackages": "true",
      "packages": "ca-certificates,gnupg,jq,vim"
    }
  },

  // some base images require a specific user name
  "remoteUser": "vscode",

  // host path to the workspace, for bind-mounting into sibling containers via -v ${LOCAL_WORKSPACE_FOLDER}:...
  "remoteEnv": { "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}" },

  // Install extensions
  "customizations": {
    "vscode": {
      // Set container specific settings
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "ms-azuretools.vscode-docker",
        "davidanson.vscode-markdownlint",
        "mutantdino.resourcemonitor"
        // "vscodevim.vim",
        // "gruntfuggly.todo-tree",
        // "humao.rest-client",
        // "ms-vscode.makefile-tools"
      ]
    }
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [8080],

  // add labels
  // "portsAttributes": {
  //   "8080": { "label": "App" }
  // },

  "hostRequirements": {
    "cpus": 4
  },

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "chmod +x .devcontainer/post-create.sh && .devcontainer/post-create.sh"

  // Use 'postStartCommand' to run commands after the container starts.
  // "postStartCommand": "chmod +x .devcontainer/post-start.sh && .devcontainer/post-start.sh",
}
